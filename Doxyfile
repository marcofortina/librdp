PROJECT_NAME           = librdp
PROJECT_NUMBER         = 0.1.0
PROJECT_BRIEF          = "C client library for RDP viewers and integration tools"
OUTPUT_DIRECTORY       = build/doxygen
INPUT                  = include/librdp docs/api-reference.md
RECURSIVE              = NO
FILE_PATTERNS          = *.h
USE_MDFILE_AS_MAINPAGE = docs/api-reference.md
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_AS_ERROR          = YES
WARN_FORMAT            = "$file:$line: $text"
QUIET                  = YES
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_DYNAMIC_SECTIONS  = YES
GENERATE_TREEVIEW      = YES
SEARCHENGINE           = YES
GENERATE_LATEX         = NO
GENERATE_XML           = YES
XML_OUTPUT             = xml
GENERATE_MAN           = NO
GENERATE_RTF           = NO
GENERATE_TAGFILE       =
OPTIMIZE_OUTPUT_FOR_C  = YES
TYPEDEF_HIDES_STRUCT   = YES
MACRO_EXPANSION        = NO
PREDEFINED             =
FULL_PATH_NAMES        = NO
SORT_MEMBER_DOCS       = YES
SORT_GROUP_NAMES       = YES
