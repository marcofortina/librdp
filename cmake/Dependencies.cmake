function(librdp_real_library_path input output)
    if(input AND EXISTS "${input}")
        get_filename_component(resolved "${input}" REALPATH)
    else()
        set(resolved "${input}")
    endif()
    set(${output} "${resolved}" PARENT_SCOPE)
endfunction()

function(librdp_fido2_reject_if_crypto_mismatch dependency)
    if(NOT LIBRDP_FIDO2_FOUND OR NOT OPENSSL_CRYPTO_LIBRARY OR NOT dependency)
        return()
    endif()
    librdp_real_library_path("${OPENSSL_CRYPTO_LIBRARY}" openssl_crypto)
    librdp_real_library_path("${dependency}" fido2_crypto)
    get_filename_component(openssl_crypto_name "${openssl_crypto}" NAME)
    get_filename_component(fido2_crypto_name "${fido2_crypto}" NAME)
    if(NOT fido2_crypto STREQUAL openssl_crypto AND NOT fido2_crypto_name STREQUAL openssl_crypto_name)
        if("${LIBRDP_WITH_FIDO2}" STREQUAL "ON")
            message(FATAL_ERROR "LIBRDP_WITH_FIDO2=ON requires libfido2 to use the selected OpenSSL libcrypto")
        endif()
        message(STATUS "librdp disabling FIDO2: libfido2 uses ${fido2_crypto_name}, selected OpenSSL uses ${openssl_crypto_name}")
        set(LIBRDP_FIDO2_FOUND 0 PARENT_SCOPE)
        set(LIBRDP_FIDO2_FOUND_REASON incompatible-openssl-crypto PARENT_SCOPE)
    endif()
endfunction()

if(LIBRDP_FIDO2_FOUND)
    if(DEFINED pkgcfg_lib_LIBRDP_FIDO2_crypto)
        librdp_fido2_reject_if_crypto_mismatch("${pkgcfg_lib_LIBRDP_FIDO2_crypto}")
    endif()
    if(LIBRDP_FIDO2_FOUND AND DEFINED pkgcfg_lib_LIBRDP_FIDO2_fido2)
        find_program(LIBRDP_LDD_EXECUTABLE NAMES ldd)
        if(LIBRDP_LDD_EXECUTABLE)
            execute_process(
                COMMAND "${LIBRDP_LDD_EXECUTABLE}" "${pkgcfg_lib_LIBRDP_FIDO2_fido2}"
                RESULT_VARIABLE LIBRDP_FIDO2_LDD_RESULT
                OUTPUT_VARIABLE LIBRDP_FIDO2_LDD_OUTPUT
                ERROR_VARIABLE LIBRDP_FIDO2_LDD_ERROR
            )
            if(LIBRDP_FIDO2_LDD_RESULT EQUAL 0)
                string(REGEX MATCH "(/[^ \t\r\n]*libcrypto[^ \t\r\n]*|libcrypto\\.so\\.[^ \t\r\n]+)"
                    LIBRDP_FIDO2_CRYPTO_DEPENDENCY "${LIBRDP_FIDO2_LDD_OUTPUT}")
                if(LIBRDP_FIDO2_CRYPTO_DEPENDENCY)
                    librdp_fido2_reject_if_crypto_mismatch("${LIBRDP_FIDO2_CRYPTO_DEPENDENCY}")
                endif()
            endif()
        endif()
    endif()
endif()

