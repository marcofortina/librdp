function(librdp_cups_reject_if_crypto_mismatch dependency)
    if(NOT LIBRDP_CUPS_FOUND OR NOT OPENSSL_CRYPTO_LIBRARY OR NOT dependency)
        return()
    endif()
    librdp_real_library_path("${OPENSSL_CRYPTO_LIBRARY}" openssl_crypto)
    librdp_real_library_path("${dependency}" cups_crypto)
    get_filename_component(openssl_crypto_name "${openssl_crypto}" NAME)
    get_filename_component(cups_crypto_name "${cups_crypto}" NAME)
    if(NOT cups_crypto STREQUAL openssl_crypto AND NOT cups_crypto_name STREQUAL openssl_crypto_name)
        if("${LIBRDP_WITH_CUPS}" STREQUAL "ON")
            message(FATAL_ERROR "LIBRDP_WITH_CUPS=ON requires cups to use the selected OpenSSL libcrypto")
        endif()
        message(STATUS "librdp disabling CUPS: cups uses ${cups_crypto_name}, selected OpenSSL uses ${openssl_crypto_name}")
        set(LIBRDP_CUPS_FOUND 0 PARENT_SCOPE)
        set(LIBRDP_CUPS_FOUND_REASON incompatible-openssl-crypto PARENT_SCOPE)
    endif()
endfunction()

function(librdp_cups_reject_if_ldd_crypto_mismatch library)
    if(NOT LIBRDP_CUPS_FOUND OR NOT library)
        return()
    endif()
    find_program(LIBRDP_LDD_EXECUTABLE NAMES ldd)
    if(NOT LIBRDP_LDD_EXECUTABLE)
        return()
    endif()
    execute_process(
        COMMAND "${LIBRDP_LDD_EXECUTABLE}" "${library}"
        RESULT_VARIABLE LIBRDP_CUPS_LDD_RESULT
        OUTPUT_VARIABLE LIBRDP_CUPS_LDD_OUTPUT
        ERROR_VARIABLE LIBRDP_CUPS_LDD_ERROR
    )
    if(LIBRDP_CUPS_LDD_RESULT EQUAL 0)
        string(REGEX MATCH "(/[^ \t\r\n]*libcrypto[^ \t\r\n]*|libcrypto\\.so\\.[^ \t\r\n]+)"
            LIBRDP_CUPS_CRYPTO_DEPENDENCY "${LIBRDP_CUPS_LDD_OUTPUT}")
        if(LIBRDP_CUPS_CRYPTO_DEPENDENCY)
            librdp_cups_reject_if_crypto_mismatch("${LIBRDP_CUPS_CRYPTO_DEPENDENCY}")
            if(NOT LIBRDP_CUPS_FOUND)
                set(LIBRDP_CUPS_FOUND 0 PARENT_SCOPE)
                set(LIBRDP_CUPS_FOUND_REASON "${LIBRDP_CUPS_FOUND_REASON}" PARENT_SCOPE)
            endif()
        endif()
    endif()
endfunction()

if(LIBRDP_CUPS_FOUND)
    if(DEFINED pkgcfg_lib_LIBRDP_CUPS_cups)
        librdp_cups_reject_if_ldd_crypto_mismatch("${pkgcfg_lib_LIBRDP_CUPS_cups}")
    elseif(LIBRDP_CUPS_LIBRARY)
        librdp_cups_reject_if_ldd_crypto_mismatch("${LIBRDP_CUPS_LIBRARY}")
    endif()
endif()
